<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"
    android:background="#F7F9F8">

    <!-- ========================================== -->
    <!-- CONTENU -->
    <!-- ========================================== -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp"
            android:paddingBottom="30dp">

            <!-- TITRE -->

            <TextView
                android:id="@+id/textTitreProfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Mon profil"
                android:textColor="#19232D"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- ESPACE -->

            <Space
                android:layout_width="match_parent"
                android:layout_height="28dp" />

            <!-- ====================================== -->
            <!-- CARTE PROFIL -->
            <!-- ====================================== -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="#E7ECE9"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"
                    android:gravity="center_horizontal"

                    android:padding="28dp">

                    <!-- AVATAR -->

                    <TextView
                        android:id="@+id/textAvatarProfil"
                        android:layout_width="76dp"
                        android:layout_height="76dp"

                        android:gravity="center"

                        android:background="@drawable/bg_avatar"

                        android:text="U"
                        android:textColor="#FFFFFF"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <!-- ESPACE -->

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="18dp" />

                    <!-- NOM -->

                    <TextView
                        android:id="@+id/textNomProfil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Utilisateur"
                        android:textColor="#19232D"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <!-- SOUS-TITRE -->

                    <TextView
                        android:id="@+id/textSousTitreProfil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="6dp"

                        android:text="Membre de CarGo"
                        android:textColor="#89938E"
                        android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ESPACE -->

            <Space
                android:layout_width="match_parent"
                android:layout_height="24dp" />


            <!-- ====================================== -->
            <!-- INFORMATIONS -->
            <!-- ====================================== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Informations"
                android:textColor="#19232D"
                android:textSize="19sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp" />


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="#E7ECE9"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- NOM -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_person"
                            android:contentDescription="Nom"
                            app:tint="#00BE87" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"

                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:text="Nom"
                                android:textColor="#89938E"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/textInformationNom"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="3dp"

                                android:text="Utilisateur"
                                android:textColor="#19232D"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ESPACE -->

            <Space
                android:layout_width="match_parent"
                android:layout_height="28dp" />


            <!-- ====================================== -->
            <!-- DECONNEXION -->
            <!-- ====================================== -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/boutonDeconnexion"
                android:layout_width="match_parent"
                android:layout_height="56dp"

                android:text="Se déconnecter"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#D64545"

                app:backgroundTint="#FFF1F1"
                app:cornerRadius="16dp"
                app:strokeColor="#F4CACA"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </ScrollView>


    <!-- ========================================== -->
    <!-- NAVIGATION -->
    <!-- ========================================== -->

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="22dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/navigation"
            android:layout_width="match_parent"
            android:layout_height="72dp"

            android:background="@android:color/transparent"

            app:itemIconTint="@color/bottom_nav_colors"
            app:itemTextColor="@color/bottom_nav_colors"

            app:labelVisibilityMode="labeled"

            app:menu="@menu/menu_bottom_navigation" />

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>